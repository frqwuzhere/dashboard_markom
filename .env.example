# Planner spreadsheet ID (defaults to the existing production spreadsheet if empty).
GOOGLE_SHEET_ID=

# Social analytics spreadsheet. Server-side only; read-only access is recommended.
GOOGLE_SOCIAL_SHEET_ID=

# Local development only: path to a service-account JSON file stored outside this repo.
# Never set this on Netlify; deployed functions use GOOGLE_SERVICE_ACCOUNT_EMAIL
# and GOOGLE_PRIVATE_KEY, which take precedence over this path.
GOOGLE_APPLICATION_CREDENTIALS=

# Deployment credentials. Used first whenever both values are present.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Long random secret used to sign application session tokens.
API_TOKEN_SECRET=
